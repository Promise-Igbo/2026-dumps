
az group create --name MyResourceGroup --location EastUS
az aks create --resource-group MyResourceGroup --name MyAKSCluster --node-count 2 --enable-rbac --generate-ssh-keys
az aks install-cli
az aks get-credentials --resource-group MyResourceGroup --name MyAKSCluster

# Install Argo CD on AKS 
kubectl create namespace argocd

# Apply the Argo CD installation manifest
kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml

# Verify the installation by checking the pods in the argocd namespace
kubectl get pods -n argocd

# Access the Argo CD UI
kubectl port-forward svc/argocd-server -n argocd 8080:443
# Get the initial admin password
ARGOCD_PASSWORD=$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d)
echo $ARGOCD_PASSWORD

# Log in with username admin and the retrieved password. 

# Deploy an Application
# Add your Git repository to Argo CD
# In the Argo CD UI, navigate to Settings > Repositories and add your repository details or
# use the argocd CLI command 
# argocd repo add <your-git-repo-url> --username <your-username> --password <your-password>

# Create an Argo CD Application
kubectl apply -f app.yaml


# OR
## Create GitOps (ArgoCD) extension (simple installation)
az aks create --resource-group deleterg --name delaks --node-count 2 --generate-ssh-keys
az provider register --namespace Microsoft.KubernetesConfiguration
az k8s-extension create --resource-group deleterg --cluster-name delaks --cluster-type managedClusters --name argocd --extension-type Microsoft.ArgoCD --release-train preview --config "redis-ha.enabled=false" --config "configs.params.application\.namespaces=namespace1,namespace2"
az aks get-credentials --resource-group deleterg --name delaks

## Access the ArgoCD UI
## ArgoCD expects TLS unless you specify otherwise, so we will expose the service with a LoadBalancer and access it over HTTP (Patch Service to Disable TLS)
kubectl -n argocd expose service argocd-server --type LoadBalancer --name argocd-server-lb --port 80 --target-port 8080
kubectl get svc -n argocd

## Username: admin
## Password for linux/macOS
kubectl get secret argocd-initial-admin-secret -n argocd -o jsonpath="{.data.password}" | base64 -d
## Password for Windows (PowerShell)
kubectl get secret argocd-initial-admin-secret -n argocd -o jsonpath="{.data.password}" | %{[System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($_))}
## bgPlccWw-s1Q9vPe

## Deploy ArgoCD application
kubectl apply -f app1.yaml

kubectl get app -n argocd

## Collect Argo CD metrics by using managed service for Prometheus
## Deploy service monitors
## configure the managed service for Prometheus add-on to scrape Prometheus metrics from the Argo CD workload.
kubectl apply -f argocd-metrics.yaml

## To Update extension configuration when needed (so the settings don't get overwritten)
az k8s-extension update --resource-group deleterg --cluster-name delaks --cluster-type managedClusters --name Microsoft.ArgoCD --config "configs.cm.url='https://<public-ip-for-argocd-ui>/auth/callback'"

## Delete the extension
az k8s-extension delete -g deleterg -c delaks -n argocd -t managedClusters --yes

