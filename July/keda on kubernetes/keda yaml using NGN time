apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: cron-scaledobject
  namespace: default
spec:
  scaleTargetRef:
    name: myapp
  minReplicaCount: 0
  maxReplicaCount: 10
  triggers:
    - type: cron
      metadata:
        timezone: Africa/Lagos
        start: "50 13 * * *"   # 1:50 PM Lagos time
        end: "59 13 * * *"     # 1:59 PM Lagos time
        desiredReplicas: "10"
