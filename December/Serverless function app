## 1. Build Serverless HTTP API on Azure with Azure Functions and FastAPI
## build a simple Hello World HTTP API using an HTTP trigger in Azure Functions.
# i installed function core tools using chocolatey
func init funcProject –python
#  Create an HTTP trigger function
cd funcProject
func new --name MyHttpFunction --template "HTTP trigger"
# The local.settings.json file stores settings used only for local development and not deployed to Azure

# Run the Azure Function locally
# Start the Function Runtime (switch to the python runtime that supports func)
py -3.13 -m venv .venv
.venv\Scripts\activate
func start
# Browse the output and Test the HTTP Endpoint

# Integrating FASTAPI
# FastAPI is a modern, high-performance web framework for building APIs in Python, It helps developers structure endpoints, validate requests, and generate API documentation more easily.
# Install FastAPI and Uvicorn
pip install fastapi uvicorn
# Create the FastAPI app (fastapi_app.py)
# Test the FastAPI app locally
uvicorn fastapi_app:app
# Open the browser at: http://127.0.0.1:8000/api/hello

