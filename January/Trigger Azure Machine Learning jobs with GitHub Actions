## Convert a Jupyter notebook to production-ready code
## Create an Azure Machine Learning job

az login

az group create `
  --name rg-mlops-devs `
  --location eastus

az config set extension.dynamic_install_allow_preview=true
az config get extension.dynamic_install_allow_preview

# Create AML workspace
az ml workspace create `
  --name mlw-mlops-devs `
  --resource-group rg-mlops-devs

# Create compute instance
az ml compute create `
  --name cpu-cluster `
  --type amlcompute `
  --size Standard_DS11_v2 `
  --min-instances 0 `
  --max-instances 2 `
  --resource-group rg-mlops-devs `
  --workspace-name mlw-mlops-devs

# Create the data asset (CLI v2)
git clone https://github.com/Promise-Igbo/mlops-aiops.git
cd mlops-aiops
az ml data create `
  --name diabetes-dev-folder `
  --version 1 `
  --type uri_folder `
  --path experimentation/data `
  --resource-group rg-mlops-devs `
  --workspace-name mlw-mlops-devs

# From the root of the repo
az ml job create `
  --file src/job.yml `
  --resource-group rg-mlops-devs `
  --workspace-name mlw-mlops-devs

# Monitor job status
az ml job list `
  --resource-group rg-mlops-devs `
  --workspace-name mlw-mlops-devs

