# Perform an audit of an Azure DevOps project
# On the codespace terminal, run
gh actions-importer audit azure-devops --output-dir tmp/audit
# if there is a usage .csv, inspect it to see all actions, secrets, and runners that are used by each successfully converted pipeline

# Forecast potential build runner usage
# On the codespace terminal, run
gh actions-importer forecast azure-devops --output-dir tmp/forecast
# completed job data will be located within the tmp/forecast folder.
# "No jobs found" because no jobs have been executed in your bootstrapped project.
# gh actions-importer azure-devops forecast --help command to perform a forecast using json files that are already present on the filesystem.

# The command will list all the files written to disk when the command succeeds.
gh actions-importer forecast azure-devops --output-dir tmp/forecast --source-file-path azure_devops/bootstrap/jobs.json

# Perform a dry-run migration of an Azure DevOps pipeline
# # On the codespace terminal, run
gh actions-importer dry-run azure-devops pipeline --pipeline-id :pipeline_id --output-dir tmp/dry-run
# This is where the pipeline id is gotten from: https://dev.azure.com/Abel0643/SeminarApp/_build/results?buildId=4&view=results. The pipeline id is 4
# The command will list all the files written to disk when the command succeeds.
gh actions-importer dry-run azure-devops pipeline --pipeline-id 4 --output-dir tmp/dry-run

# Using custom transformers to customize GitHub Actions Importer's behavior
# Custom transformers use a DSL built on top of Ruby and should be defined in a file with the .rb file extension.
# create this file by running the following command in your codespace terminal
touch transformers.rb && code transformers.rb

# Add this to the file
<!-- transform "DotNetCoreCLI@2" do |item|
  puts "This is the item: #{item}"
end -->

gh actions-importer dry-run azure-devops pipeline --pipeline-id 4 --output-dir tmp/dry-run --custom-transformers transformers.rb

# Custom transformers for environment variables
# add the following code at the top of the transformers.rb file.
<!-- env "BUILDCONFIGURATION", "Debug" -->

gh actions-importer dry-run azure-devops pipeline --pipeline-id 4 --output-dir tmp/dry-run --custom-transformers transformers.rb

# Perform a production migration of an Azure DevOps pipeline
# Run the following migrate command in the codespace terminal
