## Backend Pool Load Balancing in Azure APIM
# still use same API or create new API
# APIs > Backend > Create new backends
# For each of the backends, ie i am using 2 bckends here as an instance:

# Name: openai-eastus (Backend1); openai-westus (Backend2)
# Select Custom URL as the Backend hosting type
# Paste in the Endpoint URL of the gpt-4o deployment e.g https://testai-wst-test.openai.azure.com
# Click on + Create new for the Add a circuit breaker rule option
# Circuit breaker rule: openAIBreakerRule
# Leave Failure count as 1
# Set Failure interval to 5 minutes
# Specify Custom range as 429
# Set Trip duration to 1 minute
# Check True (Accept) for the Check 'Retry-After' header in HTTP reponse
# Click on Create to add the Azure OpenAI service as a backend

## PLEASE NOTE
# each backend can use same circuit breaker
# each backend should has different endpoints i.e each open AI resources should be created in different regions
# when testing the API, check the frontend, if the frontend is /openai/deployments/{deployment-id}/chat/completions?api-version={api-version}
# make sure when adding your endpoints on the runtime url of each backend do not add /openai to avoid duplicate
# E.g Select the `POST Creates a completion for the chat` operation, click frontend and edit
# /openai/deployments/{deployment-id}/chat/completions?api-version={api-version}: https://testai-wst-test.openai.azure.com
# /deployments/{deployment-id}/chat/completions?api-version={api-version}: https://testai-wst-test.openai.azure.com/openai
# openai/deployments/{deployment-id}/chat/completions?api-version={api-version}: https://testai-wst-test.openai.azure.com/

# APIs > Backend > Click on Load balancer and then + Create new pool
# Enter a Name (e.g., openai-backend-pool)
# Check all two backends you created earlier for the Add backends to pool option
# Test by leaving the Backend weight and priority as Send requests evenly and you can later test using the priority and weight

# Select Design, then Inbound processing and click on the "Policy Code Editor" icon to open the policy editor. Replace the existing policy with the following code:
<policies>
    <inbound>
        <base />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" output-token-variable-name="managed-id-access-token" ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["managed-id-access-token"])</value>
        </set-header>
        <set-backend-service backend-id="openai-backend-pool" />
    </inbound>
    <backend>
        <!--Set count to one less than the number of backends in the pool to try all backends until the backend pool is temporarily unavailable.-->
        <retry count="2" interval="0" first-fast-retry="true" condition="@(context.Response.StatusCode == 429 || (context.Response.StatusCode == 503 && !context.Response.StatusReason.Contains("Backend pool") && !context.Response.StatusReason.Contains("is temporarily unavailable")))">
            <forward-request buffer-request-body="true" />
        </retry>
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
        <choose>
            <!--Return a generic error that does not reveal backend pool details.-->
            <when condition="@(context.Response.StatusCode == 503)">
                <return-response>
                    <set-status code="503" reason="Service Unavailable" />
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>


# This policy does the following:
# Uses a managed identity to authenticate with the Azure OpenAI service
# Sets the backend service to the load balanced pool you created earlier
# Implements a retry policy that retries requests to the backend if it receives a 429 (Too Many Requests) status code or a 503 (Service Unavailable) status code

