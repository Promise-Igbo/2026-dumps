## Cilium is an open source, cloud native solution for providing, securing, and observing network connectivity between workloads.

# Cilium was designed for large-scale, highly dynamic containerized environments.

# Cilium provides network connectivity, allowing communication between pods and other components (within or outside a Kubernetes cluster).

# By default, Cilium supports an overlay networking model, where a virtual network spans all hosts.

# Cilium assigns an identity to groups of application containers based on relevant metadata, such as Kubernetes labels.

# Cilium provides the ability to enforce network policy corresponding to application protocol request

# Cilium can fully replace components such as kube-proxy and be used as a standalone load balancer

# Cilium strives to provide observability tooling that lets you quickly identify and fix cluster networking problems. Cilium includes a dedicated network observability component called Hubble which makes it easy to filter traffic in an actionable ways.

#  Cilium also supports both Kubernetes Ingress and Gateway API to provide a full suite of service mesh features without requiring the overhead of sidecar containers injected into every pod.

## Installation Methods: 1. Cilium CLI tool or 2. Helm chart

## Prerequisetes: A cluster and Kubectl
# Cilium documentation: https://docs.cilium.io/en/latest/gettingstarted/k8s-install-default/#cilium-quick-installation

## To prepare k8s cluster using kind (for windows) https://kind.sigs.k8s.io/docs/user/quick-start/#installation
# Make sure docker is running
curl.exe -Lo kind-windows-amd64.exe https://kind.sigs.k8s.io/dl/v0.31.0/kind-windows-amd64
Move-Item .\kind-windows-amd64.exe c:\some-dir-in-your-PATH\kind.exe

# OR
choco install kind

# Creating a Cluster
# kind create cluster

# Create a 3-node kind cluster with default CNI disabled.
kind create cluster --config=kind-config.yaml

# Confirm your new kind cluster is the default kubectl context:
kubectl config current-context

# Because you have created the cluster without a default CNI, the Kubernetes nodes are in a NotReady state.

# Install the Cilium CLI Tool
git clone git@github.com:cilium/cilium.git
# or the ssh version
curl -LO https://raw.githubusercontent.com/cilium/cilium/1.19.4/Documentation/installation/kind-config.yaml

CILIUM_CLI_VERSION=$(curl -s https://raw.githubusercontent.com/cilium/cilium-cli/main/stable.txt)
CLI_ARCH=amd64
if [ "$(uname -m)" = "aarch64" ]; then CLI_ARCH=arm64; fi
curl -L --fail --remote-name-all https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-${CLI_ARCH}.tar.gz{,.sha256sum}
sha256sum --check cilium-linux-${CLI_ARCH}.tar.gz.sha256sum
sudo tar xzvfC cilium-linux-${CLI_ARCH}.tar.gz /usr/local/bin
rm cilium-linux-${CLI_ARCH}.tar.gz{,.sha256sum}

# Install Cilium
cilium install --version 1.19.4

# In another terminal, you can use the Cilium CLI tool to watch and wait for Cilium to be fully deployed and operational
cilium status --wait

# to validate that your cluster has proper network connectivity
cilium connectivity test

# Let’s go ahead and enable Hubble
cilium hubble enable --ui

# verify Hubble components are ready using the cilium status command
cilium status

# run these tests to validate that the Cilium install is fully operational:
cilium connectivity test --request-timeout 30s --connect-timeout 10s

# The connectivity tests require at least two worker nodes to deploy successfully in a cluster, because it will not be scheduled on nodes operating in the control-plane node.

kubectl get nodes
kubectl get daemonsets --all-namespaces
kubectl get deployments --all-namespaces

